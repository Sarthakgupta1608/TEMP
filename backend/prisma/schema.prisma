datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. Identity & Profile (User, Profile, Role)
// ==========================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  role          String    @default("TRAVELLER") // TRAVELLER, AGENCY, ADMIN, SUPER_ADMIN
  status        String    @default("ACTIVE")    // PENDING, ACTIVE, SUSPENDED, DELETED
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile Profile?
  agency  Agency?

  tripRequests  TripRequest[]
  bookings      Booking[]
  reviews       Review[]
  wishlists     Wishlist[]
  notifications Notification[]
  sentMessages  Message[]      @relation("SentMessages")
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  avatarUrl        String?
  bio              String?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// 2. Agency & Verification (Agency, Docs, Wallet)
// ==========================================

model Agency {
  id             String   @id @default(uuid())
  ownerId        String   @unique
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyName    String
  slug           String   @unique
  logoUrl        String?
  description    String?
  taxIdNumber    String?  // GSTIN / PAN
  kycStatus      String   @default("VERIFIED") // PENDING, UNDER_REVIEW, VERIFIED, REJECTED, SUSPENDED
  ratingAverage  Float    @default(4.9)
  reviewCount    Int      @default(12)
  commissionRate Float    @default(10.0) // % platform commission
  operatingRegion String  @default("Sikkim & Gangtok")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documents AgencyDocument[]
  packages  Package[]
  quotes    AgencyQuote[]
  bookings  Booking[]
  reviews   Review[]
  wallet    Wallet?
}

model AgencyDocument {
  id           String   @id @default(uuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  documentType String   // TOURISM_LICENSE, GST_CERTIFICATE, BANK_PROOF, OFFICE_LEASE
  fileUrl      String
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ==========================================
// 3. Destinations & Ready-Made Packages
// ==========================================

model Destination {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  state           String
  country         String   @default("India")
  tagline         String
  description     String
  heroImage       String
  packageCount    Int      @default(0)
  agencyCount     Int      @default(0)
  startingPrice   Float    @default(14999)
  popularActivities String  @default("[]") // JSON Array String
  bestTimeToVisit String   @default("March - June")
  rating          Float    @default(4.9)
  isPopular       Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  packages     Package[]
  tripRequests TripRequest[]
}

model Package {
  id                     String   @id @default(uuid())
  agencyId               String
  agency                 Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  destinationId          String
  destination            Destination @relation(fields: [destinationId], references: [id])
  title                  String
  slug                   String   @unique
  durationDays           Int
  durationNights         Int
  pricePerPerson         Float
  originalPrice          Float?
  coverImage             String
  highlights             String   @default("[]") // JSON String
  includedAccommodations String
  includedMeals          String
  transportType          String
  isFeatured             Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  images      PackageImage[]
  itineraries PackageItinerary[]
  bookings    Booking[]
  wishlists   Wishlist[]
}

model PackageImage {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
}

model PackageItinerary {
  id          String   @id @default(uuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String
}

// ==========================================
// 4. Custom Trip Requests & Agency Quotes
// ==========================================

model TripRequest {
  id                  String   @id @default(uuid())
  requestCode         String   @unique // TR-2026-000001
  travellerId         String
  traveller           User     @relation(fields: [travellerId], references: [id], onDelete: Cascade)
  destinationId       String
  destination         Destination @relation(fields: [destinationId], references: [id])
  status              String   @default("PUBLISHED") // PUBLISHED, QUOTES_RECEIVED, BOOKED, CANCELLED
  startDate           String
  endDate             String
  durationDays        Int      @default(5)
  adultCount          Int      @default(2)
  childCount          Int      @default(0)
  budgetMin           Float    @default(10000)
  budgetMax           Float    @default(25000)
  hotelPreference     String   @default("4-Star Mountain View Resort")
  transportPreference String   @default("Private Innova Crysta SUV")
  specialRequests     String?
  aiStructuredSpec    String?  // JSON String of extracted intent
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  quotes   AgencyQuote[]
  booking  Booking?
}

model AgencyQuote {
  id                      String   @id @default(uuid())
  tripRequestId           String
  tripRequest             TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)
  agencyId                String
  agency                  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  status                  String   @default("SUBMITTED") // SUBMITTED, ACCEPTED, REJECTED, WITHDRAWN
  totalPrice              Float
  pricePerPerson          Float
  hotelCategory           String
  hotelNames              String   // Comma separated
  vehicleType             String
  includedMeals           String   // JSON String
  includedActivities      String   // JSON String
  excludedItems           String   // JSON String
  cancellationPolicy      String   @default("100% Refund if cancelled 7 days prior")
  aiMatchScore            Int      @default(90)
  aiRecommendationReason  String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  items   QuoteItem[]
  booking Booking?
}

model QuoteItem {
  id          String      @id @default(uuid())
  quoteId     String
  quote       AgencyQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  category    String      // Accommodation, Transport, Activity, Permit, Tax
  description String
  amount      Float
}

// ==========================================
// 5. Bookings, Payments & Ledger (Wallet)
// ==========================================

model Booking {
  id               String       @id @default(uuid())
  bookingCode       String       @unique // TRV-2026-000001
  travellerId       String
  traveller         User         @relation(fields: [travellerId], references: [id])
  agencyId          String
  agency            Agency       @relation(fields: [agencyId], references: [id])
  tripRequestId     String?      @unique
  tripRequest       TripRequest? @relation(fields: [tripRequestId], references: [id])
  packageId         String?
  package           Package?     @relation(fields: [packageId], references: [id])
  quoteId           String?      @unique
  quote             AgencyQuote? @relation(fields: [quoteId], references: [id])
  
  status           String       @default("CONFIRMED") // PENDING_PAYMENT, CONFIRMED, COMPLETED, CANCELLED
  grossAmount      Float
  commissionAmount Float
  netAgencyAmount  Float
  startDate        String       @default("2026-10-15")
  endDate          String       @default("2026-10-20")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payment      Payment?
  review       Review?
  conversation Conversation?
}

model Payment {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status            String   @default("SUCCESS") // INITIATED, SUCCESS, FAILED, REFUNDED
  amount            Float
  razorpayOrderId   String   @unique
  razorpayPaymentId String   @unique
  razorpaySignature String?
  paymentMethod     String   @default("RAZORPAY_UPI")
  createdAt         DateTime @default(now())

  walletTransactions WalletTransaction[]
}

model Wallet {
  id          String   @id @default(uuid())
  agencyId    String   @unique
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  balance     Float    @default(166000.0)
  escrowHold  Float    @default(42000.0)
  totalEarned Float    @default(208000.0)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  type      String   // ESCROW_HOLD, PAYOUT_RELEASE, COMMISSION_DEDUCTION
  amount    Float
  reference String
  createdAt DateTime @default(now())
}

// ==========================================
// 6. Support, Messages, Reviews, Wishlist
// ==========================================

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travellerId String
  traveller   User     @relation(fields: [travellerId], references: [id])
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id])
  rating      Int      @default(5)
  comment     String
  createdAt   DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, packageId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  senderRole     String       // TRAVELLER, AGENCY
  text           String
  createdAt      DateTime     @default(now())
}
