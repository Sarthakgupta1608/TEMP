# Port & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/traveller_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="traveller_super_secret_access_token_key_2026"
JWT_REFRESH_SECRET="traveller_super_secret_refresh_token_key_2026"

# OpenAI Integration Key
AI_API_KEY="sk-placeholder-openai-key"

# Razorpay Payments Integration (Sandbox / Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_razorpay_secret"

# Cloudinary Storage Key
CLOUDINARY_CLOUD_NAME="traveller-cloud"
CLOUDINARY_API_KEY="placeholder_cloudinary_api_key"
CLOUDINARY_API_SECRET="placeholder_cloudinary_api_secret"
